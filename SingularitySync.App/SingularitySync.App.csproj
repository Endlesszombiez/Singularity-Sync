<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>Assets/SingularitySync.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>SingularitySync</AssemblyName>
  </PropertyGroup>
  <ItemGroup><EmbeddedResource Include="Assets/SingularitySync.ico" LogicalName="SingularitySync.AppIcon" /></ItemGroup>
  <ItemGroup><ProjectReference Include="../SingularitySync.Core/SingularitySync.Core.csproj" /></ItemGroup>
</Project>
